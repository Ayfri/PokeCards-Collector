# Supabase
PUBLIC_SUPABASE_URL=

# New-style keys (Settings > API Keys). The legacy anon / service_role pair works until the end of 2026.
# Publishable (sb_publishable_...) is low-privilege and ships to the browser.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (sb_secret_...) bypasses row level security. No PUBLIC_ prefix: SvelteKit serialises every PUBLIC_ var
# into the SSR HTML. In production it is a Wrangler secret, not a value in this file.
SUPABASE_SECRET_KEY=

# Bearer token for POST https://pokecards-scraper.ayfri.workers.dev/run
SCRAPER_TRIGGER_TOKEN=

# Images (card art is served straight from assets.tcgdex.net; set to true to render placeholders instead)
PUBLIC_NO_IMAGES=false
